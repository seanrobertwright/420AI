# Milestone 2 environment — copy to .env and fill the two secrets.
#   cp .env.example .env
# .env is gitignored; only this template is committed. NEVER commit a real key.

# Central Archive connection (dev database). Host port 5433 — see docker-compose.yml.
# This is the OWNER role: it owns the tables and runs every db:* CLI (migrate, rollback,
# reprice, reparse, rotate-key) and the break-glass path. RLS is INERT against it (M15 15.3).
DATABASE_URL=postgres://420ai:420ai@localhost:5433/420ai

# M15 15.3 — the NON-OWNER application role the ingest server connects as. RLS only enforces
# against a role without `rolbypassrls`, so booting the server on DATABASE_URL would leave
# every policy decorative. The server HARD-FAILS without this (D-15.3-2).
# Create/rotate the role with:  npm run db:provision-app-role
APP_DB_PASSWORD=
DATABASE_URL_APP=postgres://420ai_app:<password>@localhost:5433/420ai

# Test database (same server, separate DB). Integration tests self-skip if unset.
DATABASE_URL_TEST=postgres://420ai:420ai@localhost:5433/420ai_test
# The app-role handle for the same test DB — the two-role RLS suite needs BOTH: the owner to
# TRUNCATE and seed, the app role to make every assertion mean something.
DATABASE_URL_TEST_APP=postgres://420ai_app:<password>@localhost:5433/420ai_test

# Field-level encryption key — 32 bytes, base64-encoded. Held by the app, NEVER
# stored in the DB (PRD §18.1). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ARCHIVE_ENCRYPTION_KEY=

# --- M12 12.4e key rotation (OPTIONAL keyring mode) ---
# ARCHIVE_ENCRYPTION_KEY (above, single key) remains the default and is byte-for-byte
# unchanged. To ROTATE the key, switch to a keyring: a JSON map of keyId→base64-key plus the
# active keyId. The keyId rides inside each ciphertext, so old + new keys coexist while
# `npm run db:rotate-key` re-encrypts every row. Carry the OLD key in the keyring until
# rotation completes, then it may be removed. Full procedure: docs/guide/operations.md.
#   ARCHIVE_ENCRYPTION_KEYS={"legacy":"<old-b64>","v2":"<new-b64>"}
#   ARCHIVE_ENCRYPTION_ACTIVE_KEY_ID=v2
ARCHIVE_ENCRYPTION_KEYS=
ARCHIVE_ENCRYPTION_ACTIVE_KEY_ID=

# ADMIN_TOKEN was REMOVED in M15 15.9 (D-M15-7). It is read by nothing and authenticates
# nothing — if you still have a value here, the server ignores it and every client presenting
# it now gets a 401. This block is left in place, rather than deleted, so an upgrading operator
# finds out WHY their token stopped working instead of guessing.
#
# WHY IT WENT: it was one shared secret with no owner. Every holder resolved to the same
# bootstrap admin, so nothing was attributable; it could not be revoked without editing env and
# restarting the server, which revoked it for every client at once; it never expired; and it was
# always `owner`, so a scheduled reports script held full ownership of the deployment.
#
# WHAT REPLACES IT — a per-user API KEY, one per machine client:
#   1. Log in as ADMIN_EMAIL (below), then POST /v1/auth/api-keys with a name, an optional
#      `role` (defaults to inheriting yours — use the LOWEST rung that works), and your current
#      password. The `k420_…` token comes back EXACTLY ONCE; it is stored only as a sha256 hash
#      and cannot be recovered, only re-minted.
#   2. Put it in the desktop app under Settings → API key, and in `API_KEY` for
#      `npm run reports:generate`.
#   3. Revoke any single key with DELETE /v1/auth/api-keys/:id — without touching the others.
# See docs/guide/operations.md → "API keys".

# --- Admin login (M12 12.3) ---
# A real single-user admin login for the dashboard. POST /v1/auth/login verifies the
# password (scrypt) and issues an HMAC session token BOUND TO A `sessions` ROW (M15 15.6); the
# dashboard stores it in an httpOnly cookie and its middleware verifies the signature on every
# request. Ingest additionally checks the row on every request, which is what makes revocation work.
#
# Single-admin email. Optional — defaults to seanrobertwright@gmail.com (the legacy
# single-user identity) when unset, so existing data keeps resolving the same user.
ADMIN_EMAIL=
# Admin password. Seeded → scrypt-hashed into the users table on EVERY ingest boot, so
# rotating it == change this value + restart. If UNSET, login is disabled and ingest logs a
# one-line warning — and as of M15 15.9 that means NOTHING can authenticate, because minting an
# API key requires a login first. This is now the whole first-run bootstrap: set it.
# M15 15.9: rotating this does NOT revoke API keys (D-15.9-9) — a key is not derived from the
# password, and breaking every machine client on a routine rotation would be worse than the
# threat. Removing someone from the org DOES revoke theirs.
# M15 15.6: rotating this does NOT end existing sessions — the boot seed cannot tell a rotation
# from a restart (scrypt re-salts each time), so it never revokes. If you are rotating because the
# password LEAKED, call POST /v1/auth/sessions/revoke-all afterwards. See docs/guide/operations.md.
ADMIN_PASSWORD=
# HMAC key that signs/verifies session tokens. REQUIRED (ingest refuses to boot without it).
# MUST be set IDENTICALLY for BOTH the ingest process AND the dashboard — the dashboard
# middleware verifies the cookie with this same secret (a mismatch fails every login).
# Rotating it invalidates every live session on the deployment — but as of M15 15.6 that is the
# BLUNT instrument, not the revocation mechanism. Per-session and per-user revocation is
# POST /v1/auth/logout, DELETE /v1/auth/sessions/:id and POST /v1/auth/sessions/revoke-all
# (docs/guide/operations.md §15.6). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Port the ingest API listens on.
INGEST_PORT=8420

# --- M8 AI Interpretation Pipeline (PRD §16.2) ---
# Configures the Analysis Provider behind POST /v1/sessions/:id/interpretations and
# POST /v1/projects/:id/interpretations. Leaving ANALYSIS_PROVIDER / ANALYSIS_API_KEY
# UNSET keeps the rest of the API fully working; only the interpretation endpoints
# return 503 ("analysis provider not configured"). Redaction runs before anything is
# sent to the provider or stored, so secrets never leave the archive.
#
# Provider: "anthropic" (Anthropic Messages API, default) or "openai" (OpenAI-compatible
# Chat Completions — Ollama / LM Studio / vLLM / OpenAI).
ANALYSIS_PROVIDER=anthropic
# Your provider API key (Anthropic key for "anthropic"; the bearer key for "openai").
ANALYSIS_API_KEY=
# Model id. For Anthropic, a current balance-tier model (verify against the latest
# Claude model ids); for an OpenAI-compatible endpoint, that endpoint's model name.
ANALYSIS_MODEL=claude-sonnet-4-6
# OpenAI-compatible providers only — the base URL (e.g. http://localhost:11434/v1 for
# Ollama). Leave blank for Anthropic (it uses the fixed Messages API endpoint).
ANALYSIS_BASE_URL=
# Max output tokens for one interpretation call.
ANALYSIS_MAX_OUTPUT_TOKENS=4096
# Per-call request timeout (ms).
ANALYSIS_TIMEOUT_MS=60000

# --- M9 Live Monitor (PRD §8.4, §20) ---
# SSE push cadence for GET /v1/monitor/stream (ms). Optional — defaults to 3000.
MONITOR_STREAM_INTERVAL_MS=3000
# Collector heartbeat cadence (ms). Optional — the `collector watch` daemon sends a
# best-effort liveness ping (sync backlog + version) on this cadence; defaults to 30000.
# Override per-run with `collector watch --heartbeat-interval <ms>`.
HEARTBEAT_INTERVAL_MS=30000

# --- M12 12.6 alert delivery (PRD §20) ---
# POST the firing JSON to this webhook when an operational alert newly opens (Slack/Discord/
# n8n/email-bridge). UNSET = delivery disabled (the firing still shows in the dashboard — the
# webhook is a convenience push, not the durable record). At-most-one ATTEMPT per firing.
ALERT_WEBHOOK_URL=
# Per-delivery request timeout (ms). Optional — defaults to 5000.
ALERT_WEBHOOK_TIMEOUT_MS=5000

# --- M13 13.5 SMTP alert delivery (PRD §20) ---
# Send alert emails via SMTP in addition to (or instead of) the webhook. Enabled ONLY when
# ALL THREE are set - an incomplete config is treated as disabled. Both open-firing and
# resolve notices flow through it; at-most-one delivery ATTEMPT per firing (per state).
# ALERT_SMTP_URL is a nodemailer transport URL, e.g. smtps://user:pass@smtp.example.com:465
ALERT_SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- M15 15.5 identity (PRD §24) ---
# Self-service signup. OFF unless this is the LITERAL string "true" (D-M15-6) — a deployment is
# invite-only until an operator opts in, and any other value (yes/1/TRUE) leaves it closed. With it
# off, POST /v1/auth/signup answers 403 and the only way to add a person is POST /v1/members/invite.
SELF_SIGNUP_ENABLED=false
# Transactional mail for invites + password resets. Needs only a URL + a FROM address (each message
# goes to the invitee or the account holder, so there is no fixed recipient like ALERT_EMAIL_TO).
# BOTH DEFAULT TO THE 13.5 ALERT SETTINGS ABOVE - SMTP_URL falls back to ALERT_SMTP_URL and
# MAIL_FROM to ALERT_EMAIL_FROM - so an upgrading operator who already sends alert email gets
# invites with no new configuration and need not re-enter credentials.
SMTP_URL=
MAIL_FROM=
# Base URL of the DASHBOARD, used to build the links inside those emails (invite/reset). Defaults
# to http://localhost:3000, which is `next dev`'s port. Set it to your real origin in production or
# every invitation will point at the recipient's own machine.
APP_BASE_URL=http://localhost:3000
# With NO mail transport configured, the two paths behave DIFFERENTLY on purpose (D-15.5-10):
# POST /v1/members/invite (admin-gated) returns the invite token in its response for the admin to
# pass on out-of-band, while POST /v1/auth/password-reset (UNAUTHENTICATED) answers 503 — handing a
# reset token to an anonymous caller would be a complete account-takeover primitive.

# --- M15 15.7 SSO (Google + GitHub, identity only) ---
# A provider is LIVE only when BOTH its id and its secret are set; a half-configuration is treated
# as absent (a client id with no secret would fail at the token exchange with an opaque 502).
# Leave all four empty to run without SSO — nothing else changes, and the login page renders no
# provider buttons. Register each OAuth app with the redirect URI
#   <APP_BASE_URL>/api/auth/sso/google/callback   /   <APP_BASE_URL>/api/auth/sso/github/callback
# NO repo/API scopes are requested: Google gets `openid email`, GitHub `read:user user:email`, and
# no provider access token is ever stored (D-15.7-5).
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=
# Whether an SSO login may CREATE an account for an address that has none. OFF unless this is the
# LITERAL string "true" (D-15.7-7), and deliberately SEPARATE from SELF_SIGNUP_ENABLED so an
# operator can open SSO self-provisioning without opening password signup. With it off, a new
# person arrives through SSO only by accepting an invitation.
SSO_SIGNUP_ENABLED=false
# Outbound timeout for the token/profile hops (ms). Default 10000.
SSO_TIMEOUT_MS=10000
# NOTE the behaviour operators most often file as a bug: an SSO identity whose verified email
# already has a 420AI account is NEVER auto-adopted — it answers 409 link_required. Sign in the way
# you already can and connect the provider from Settings. That refusal is the slice's whole point.

# --- M12 12.4b observability ---
# Structured-logging level for the ingest server (pino): trace|debug|info|warn|error|fatal.
# The authorization + cookie headers are always redacted from logs regardless of level.
LOG_LEVEL=info

# --- M12 12.4c rate limiting ---
# Rate limiting is ON by default; set RATE_LIMIT_ENABLED=false to disable entirely. The global
# limit is generous (the ingest hot path); the login limit is the brute-force guard on
# POST /v1/auth/login. timeWindow accepts @fastify/rate-limit durations ("1 minute", "15 minutes").
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=15 minutes

# --- M12 12.4d backups ---
# Where `npm run backup` writes timestamped gzipped pg_dumps, and how many days of dump FILES
# to keep (older dumps are pruned; DB rows are never touched — raw_source_records is sacred).
BACKUP_DIR=./backups
RETENTION_DAYS=14

# --- M9 dashboard (apps/dashboard, Next.js) ---
# Where the dashboard's server-side proxy reaches the ingest API. The browser NEVER holds
# any credential — Server Components / Route Handlers add the admin's session-token bearer
# on the server→ingest hop.
INGEST_URL=http://localhost:8420
# M15 15.9 (D-M15-7) — the API KEY that `npm run reports:generate` presents (scripts/generate-reports.mjs).
# Mint it from the dashboard (Settings → API keys) or POST /v1/auth/api-keys, at the LOWEST rung that
# works: the reports script only needs to POST reports, so a `member` key is enough — it never needed
# the deployment ownership the retired ADMIN_TOKEN gave it. Leave BLANK if you do not run scheduled
# reports; the script exits with a clear message rather than a 401. Revoke it on its own if the cron
# host is ever compromised.
API_KEY=
# M12 12.3: the dashboard holds no machine credential at all. It needs SESSION_SECRET (above) —
# the SAME value as the ingest process — so its middleware can verify the login cookie.
# Never expose SESSION_SECRET via a NEXT_PUBLIC_* var.
