{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "420AI Collector",
  "version": "0.1.0",
  "identifier": "ai.420.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "420AI Collector",
        "width": 900,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "420AI",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/collector"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NDI5OUE1NkFEMUE2NzYKUldSMnB0RnFwWmxDSjlsRE9obUtQWDhld1dtR3k4NktkN2tjbXJ3Zld1R0gwTVlPeXdoMDZkSjIK",
      "endpoints": [
        "https://github.com/seanrobertwright/420AI/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
